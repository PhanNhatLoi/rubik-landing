{
  "name": "rubik-landing",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:https": "DEV_HTTPS=1 vite",
    "cert:dev": "mkdir -p .cert && openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 365 -keyout .cert/key.pem -out .cert/cert.pem -subj /CN=rubik-dev"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.2",
    "vitest": "^3.2.7"
  }
}
